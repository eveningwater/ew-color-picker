{
  "name": "ew-color-picker-monorepo",
  "private": true,
  "version": "2.0.4",
  "description": "一个基于typescript封装的颜色选择器",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:utils": "pnpm --filter @ew-color-picker/utils build",
    "build:alpha": "pnpm --filter @ew-color-picker/alpha build",
    "build:hue": "pnpm --filter @ew-color-picker/hue build",
    "build:panel": "pnpm --filter @ew-color-picker/panel build",
    "build:input": "pnpm --filter @ew-color-picker/input build",
    "build:inputNumber": "pnpm --filter @ew-color-picker/input-number build",
    "build:button": "pnpm --filter @ew-color-picker/button build",
    "build:checkbox": "pnpm --filter @ew-color-picker/checkbox build",
    "build:predefine": "pnpm --filter @ew-color-picker/predefine build",
    "build:colorMode": "pnpm --filter @ew-color-picker/color-mode build",
    "build:select": "pnpm --filter @ew-color-picker/select build",
    "build:gradient": "pnpm --filter @ew-color-picker/gradient build",
    "build:copyColor": "pnpm --filter @ew-color-picker/copy-color build",
    "build:eyedropper": "pnpm --filter @ew-color-picker/eyedropper build",
    "build:ewColorPicker": "pnpm --filter @ew-color-picker/ew-color-picker build",
    "build:style": "pnpm --filter @ew-color-picker/style build",
    "build:box": "pnpm --filter @ew-color-picker/box build",
    "build:core": "pnpm --filter @ew-color-picker/core build",
    "build:all": "node scripts/build.js",
    "dev": "pnpm -r dev",
    "dev:preview": "node scripts/dev-server.js",
    "example": "node scripts/dev-server.js",
    "clean": "pnpm -r clean",
    "build:docs": "node scripts/build-docs.js && cd docs && DOCS_BASE=/ew-color-picker/ npm run build",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "npm run build:docs",
    "docs:preview": "cd docs && npm run preview",
    "start:docs": "cd docs && npm run preview",
    "publish": "pnpm -r publish",
    "publicPublish": "pnpm -r publish --access public",
    "deploy": "npm run build:docs && gh-pages -d gh-pages",
    "release-docs": "gh-pages -d gh-pages",
    "test": "node scripts/test.js",
    "test:run": "vitest run",
    "test:coverage": "node scripts/test.js --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "main": "packages/ew-color-picker/dist/index.min.js",
  "module": "packages/ew-color-picker/dist/index.esm.js",
  "types": "packages/ew-color-picker/dist/ew-color-picker/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eveningwater/ew-color-picker.git"
  },
  "keywords": [
    "ew-color-picker"
  ],
  "author": "eveningwater(854806732@qq.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eveningwater/ew-color-picker/issues"
  },
  "homepage": "https://github.com/eveningwater/ew-color-picker#readme",
  "devDependencies": {
    "@ew-color-picker/utils": "workspace:*",
    "@rollup/plugin-replace": "^5.0.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "chalk": "5.3.0",
    "chokidar": "^4.0.3",
    "gh-pages": "^6.3.0",
    "happy-dom": "^21.0.4",
    "rollup": "4.67.5",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-typescript2": "0.36.0",
    "rollup-plugin-uglify": "6.0.4",
    "sass": "^1.108.0",
    "tslib": "^2.6.0",
    "typescript": "5.4.5",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
